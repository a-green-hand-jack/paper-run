{
  "name": "paper-run",
  "version": "0.5.0",
  "description": "An OpenCode-native system for autonomous and collaborative manuscript production and independent review",
  "type": "module",
  "bin": {
    "paper-run": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit --project integration",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:smoke": "vitest run --project smoke",
    "prepublishOnly": "npm run build",
    "test:all": "vitest run"
  },
  "keywords": [
    "opencode",
    "paper",
    "writing",
    "review",
    "latex",
    "research",
    "agent",
    "harness"
  ],
  "author": "a-green-hand-jack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-green-hand-jack/paper-run.git"
  },
  "bugs": {
    "url": "https://github.com/a-green-hand-jack/paper-run/issues"
  },
  "homepage": "https://github.com/a-green-hand-jack/paper-run#readme",
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.11",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
