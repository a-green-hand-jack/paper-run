{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{MODEL}}",
  "default_agent": "paper-writer",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "python3 .agents/*": "allow",
      "bash .agents/tools/*": "allow",
      "./.agents/tools/*": "allow",
      "make *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git show*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "*": "ask"
    }
  }
}
